# Plantilla del `.env` real que vive en el servidor (~/gota-backend-deploy/.env,
# NUNCA en git). Copiar a `.env` ahí y completar valores reales.

# BD propia — ya NO es un contenedor postgres propio: GOTA vive como esquema "gota"
# dentro de bd_conhydra (producción), mismo servidor/BD que sig. PROPIA_DB_URL usa el
# mismo host/puerto/usuario/password que SIG_DB_* de abajo, solo cambia el nombre de
# la BD (bd_conhydra, no "gota") y el schema (via PROPIA_DB_SCHEMA).
PROPIA_DB_URL=postgresql+asyncpg://postgres:@172.16.5.222:5432/bd_conhydra
PROPIA_DB_SCHEMA=gota

# sig (bd_conhydra) — SOLO LECTURA. IP LAN directa (servidor dentro de la red de
# EPSEL). Si se despliega en un servidor sin ruta directa a esta IP, cambiar por el
# túnel SSH correspondiente sin tocar código, solo estas vars.
SIG_DB_HOST=172.16.5.222
SIG_DB_PORT=5432
SIG_DB_NAME=bd_conhydra
SIG_DB_USER=postgres
SIG_DB_PASSWORD=

# Mismo destino que las 5 variables SIG_DB_* de arriba, pero como connection string
# completa — la usa Martin (martin-config.template.yaml), no el backend. Debe apuntar
# a la misma BD.
SIG_DATABASE_URL=postgresql://postgres:@172.16.5.222:5432/bd_conhydra

# Auth
JWT_SECRET=generar-con-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Origen del frontend, si se sirve en un dominio distinto al backend (con nginx
# same-origin delante de todo — ver EPSEL-MOVIL/nginx.conf — normalmente no hace falta).
ALLOWED_ORIGIN=

# Imágenes a desplegar — el workflow de deploy de cada repo sobreescribe la suya con
# el tag del commit que disparó el push a main; dejar en :latest para pruebas manuales.
BACKEND_IMAGE=ghcr.io/ivanedac/epsel-backend:latest
FRONTEND_IMAGE=ghcr.io/ivanedac/epsel-movil:latest

# Único puerto publicado al host: el frontend (nginx) sirve la SPA y hace de proxy
# hacia backend/martin, que ya NO publican puerto propio (solo alcanzables dentro de
# la red docker `gota`).
FRONTEND_PORT=80
