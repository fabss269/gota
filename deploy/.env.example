# BD — desde 2026-08-10 es el servicio `postgres` de este mismo docker-compose
# (postgis/postgis), ya no un servidor externo. `DB_HOST=postgres` es el nombre
# del servicio, resuelto por la red docker `gota` — no una IP.
# NUNCA copiar estos valores tal cual a un .env real: son placeholders. El .env
# real de producción vive solo en el VPS (/opt/epsel-deploy/.env), nunca en git,
# con contraseña y secretos generados de cero (ej. openssl rand -hex 32 para
# DB_PASSWORD y JWT_SECRET) — no reusar ningún valor que haya estado en este
# archivo antes de 2026-08-10: quedaron una contraseña y un JWT_SECRET reales
# expuestos en el historial de git (no un supuesto — revisar `git log -p --
# deploy/.env.example` si hace falta confirmar).
# PENDIENTE de Edgar: rotar esa contraseña en cualquier servidor donde siga
# siendo válida (el 172.16.5.222 viejo, si sigue en pie) — este commit solo
# limpia el archivo hacia adelante, no invalida el valor viejo por sí solo.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bd_conhydra
DB_USER=postgres
DB_PASSWORD=cambiar-esto-generado-con-openssl-rand
PROPIA_DB_SCHEMA=gota

# Datamart
DATAMART_NAME=datamart_gota

SIG_DATABASE_URL=postgresql://postgres:cambiar-esto-generado-con-openssl-rand@postgres:5432/bd_conhydra

JWT_SECRET=cambiar-esto-generado-con-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Imagenes: el workflow de cada repo sobreescribe la suya con el tag del commit
BACKEND_IMAGE=ghcr.io/ivanedac/epsel-backend:latest
FRONTEND_IMAGE=ghcr.io/ivanedac/epsel-movil:latest

FRONTEND_PORT=80