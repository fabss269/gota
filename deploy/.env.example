# Plantilla del `.env` real que vive en el servidor (~/gota-backend-deploy/.env,
# NUNCA en git). Copiar a `.env` ahí y completar valores reales.

# BD propia (contenedor `postgres` de este mismo compose)
POSTGRES_USER=gota
POSTGRES_PASSWORD=cambiar-por-una-password-fuerte
POSTGRES_DB=gota

# sig (bd_conhydra) — SOLO LECTURA. Configurable: en un servidor dentro de la red de
# EPSEL usar la IP LAN directa; en cualquier otro lugar (como este servidor de prueba),
# usar el túnel público ssh.kasqan.com:15432. Cambiar sin tocar código, solo estas vars.
SIG_DB_HOST=172.16.5.222
SIG_DB_PORT=5432
SIG_DB_NAME=bd_conhydra
SIG_DB_USER=postgres
SIG_DB_PASSWORD=

# Mismo destino que las 5 variables SIG_DB_* de arriba, pero como connection string
# completa — la usa Martin (martin-config.template.yaml), no el backend. Debe apuntar
# a la misma BD.
SIG_DATABASE_URL=postgresql://postgres:@172.16.5.222:5432/bd_conhydra

# Auth
JWT_SECRET=generar-con-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Imagen a desplegar — el workflow de deploy sobreescribe esto con el tag del commit
# que disparó el push a main; dejar en :latest para pruebas manuales.
BACKEND_IMAGE=ghcr.io/ivanedac/epsel-backend:latest

# Puertos publicados al host (ajustar si ya están ocupados por otro servicio)
BACKEND_PORT=8000
MARTIN_PORT=3000
