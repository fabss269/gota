# Backend real (gota-backend, dev local): .venv/bin/uvicorn app.main:app --port 8123 --reload
EXPO_PUBLIC_API_BASE_URL=http://localhost:8123

# style.json de MapLibre servido por el propio Expo dev server desde public/
# (Martin debe estar corriendo en :3000 apuntando a `sig`, ver deploy/martin-config.template.yaml en gota-backend)
EXPO_PUBLIC_MAP_STYLE_URL=http://localhost:8081/map-style.json

# Tiles de Martin para el mapa del Dashboard (DashboardMap.web.tsx) — bug real
# encontrado 2026-08-07: sin esta variable, el fallback hardcodeado es
# 'http://localhost:3000', que solo resuelve para quien navega desde la MISMA
# máquina que corre Martin. Cualquier otra PC ve "Failed to fetch" al entrar al
# dashboard. En producción/túnel usar https://tiles-gota.kasqan.com.
EXPO_PUBLIC_MARTIN_URL=http://localhost:3000
