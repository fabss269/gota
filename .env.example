
DB_HOST=localhost
# DB_HOST = 172.16.5.222
DB_PORT=5432
DB_NAME=bd_conhydra
DB_USER=usuario
DB_PASSWORD=password

PROPIA_DB_SCHEMA=gota

DATAMART_NAME=

# Auth
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Caché externa (sector/prioridad/estado de incidente — ver specs/00-arquitectura.md §7)
REDIS_URL=redis://localhost:6379/0

ALLOWED_ORIGIN=

# Ingest DANA (2026-08-04) — hoy apunta a dana_mock/ (simulación local, mientras
# DANA no nos da acceso a su API real). En producción, cuando DANA habilite el
# acceso real, solo cambia esta URL, nada más del ingest.
DANA_API_BASE_URL=http://localhost:8100
# Cadencia rápida (decisión 2026-08-04): dana_mock emite 1 ticket cada 5s, el
# backend pull-ea cada 30s — así el pipeline completo es observable en minutos.
DANA_POLL_INTERVAL_SECONDS=30
DANA_POLL_OVERLAP_SECONDS=10
