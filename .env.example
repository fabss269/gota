PROPIA_DB_URL=postgresql+asyncpg://usuario:password@localhost:5432/gota

# sig (bd_conhydra) — SOLO LECTURA, vía el tunel SSH existente
SIG_DB_HOST=ssh.kasqan.com
SIG_DB_PORT=15432
SIG_DB_NAME=bd_conhydra
