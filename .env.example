# BD propia (incidente/reclamo/usuario/catalogos) — lectura y escritura.
# Dev local: BD standalone "gota", tablas en "public" (PROPIA_DB_SCHEMA default).
# Producción: GOTA vive como esquema dentro de bd_conhydra — usar el mismo host/puerto/
# BD que SIG_DB_* de abajo, con PROPIA_DB_SCHEMA=gota (ver deploy/.env.example).
PROPIA_DB_URL=postgresql+asyncpg://usuario:password@localhost:5432/gota
PROPIA_DB_SCHEMA=public

# sig (bd_conhydra) — SOLO LECTURA. Conexión directa por IP LAN (dentro de la red de
# EPSEL); dev local remoto puede seguir usando el túnel SSH ssh.kasqan.com:15432 si no
# está en esa red.
SIG_DB_HOST=172.16.5.222
SIG_DB_PORT=5432
SIG_DB_NAME=bd_conhydra
SIG_DB_USER=postgres
SIG_DB_PASSWORD=

# Auth
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Caché externa (sector/prioridad/estado de incidente — ver specs/00-arquitectura.md §7)
REDIS_URL=redis://localhost:6379/0

# Origen del frontend en producción, si se accede por un dominio distinto al backend
# (con nginx same-origin delante de todo, normalmente no hace falta). Ej:
# ALLOWED_ORIGIN=https://gota.epsel.gob.pe
ALLOWED_ORIGIN=
