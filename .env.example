# BD única (gota + sig como schemas de la misma BD, ver app/core/config.py) —
# esquema de variables actualizado 2026-08-02 (antes PROPIA_DB_URL/SIG_DB_* por
# separado; ahora una sola conexión Postgres, propia_db_url/sig_db_url_effective
# se derivan de esto). Dev local: BD standalone (ej. bd_conhydra_local, backup
# restaurado), producción: bd_conhydra real (LAN 172.16.5.222 o túnel SSH
# ssh.kasqan.com:15432 si no estás en la red de EPSEL).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_conhydra
DB_USER=usuario
DB_PASSWORD=password

# Schema donde viven las tablas propias de GOTA dentro de esa BD (sig es el otro
# schema, solo lectura, ya viene con los datos de CONHYDRA).
PROPIA_DB_SCHEMA=gota

# BD del datamart — opcional, mismo host/puerto/usuario/password de arriba, solo
# cambia el nombre. Dejar vacío/sin definir si no aplica (settings.datamart_db_url
# devuelve None).
DATAMART_NAME=

# Auth
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# Caché externa (sector/prioridad/estado de incidente — ver specs/00-arquitectura.md §7)
REDIS_URL=redis://localhost:6379/0

# Origen del frontend en producción, si se accede por un dominio distinto al backend
# (con nginx same-origin delante de todo, normalmente no hace falta). Ej:
# ALLOWED_ORIGIN=https://gota.epsel.gob.pe
ALLOWED_ORIGIN=
